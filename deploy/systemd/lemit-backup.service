# LEMIT DB 백업 (#44). 설치·확인 방법은 docs/DEPLOY.md §9.
[Unit]
Description=LEMIT PostgreSQL backup (scripts/backup_db.sh)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/lemit
Environment=BACKUP_DIR=/home/ec2-user/lemit-backups
Environment=BACKUP_KEEP=14
ExecStart=/usr/bin/bash scripts/backup_db.sh
