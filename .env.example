# 개발용 예시입니다. 이 파일을 .env로 복사해 값을 채웁니다 (복사 명령은 README "환경변수 설정").
# .env는 커밋하지 않습니다.
# 운영 서버(#7)에서는 새 비밀키, DJANGO_DEBUG=False, 실제 도메인의 ALLOWED_HOSTS·CSRF_TRUSTED_ORIGINS를 씁니다.

# 새 키 만들기: python -c "import secrets; print(secrets.token_urlsafe(50))"
# ($ 문자는 Docker Compose가 변수로 해석하므로 넣지 않습니다)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL 18 (개발용 compose.yaml의 db 서비스 기준)
POSTGRES_DB=lemit
POSTGRES_USER=lemit
# 영문·숫자·-_ 만 (URL에 그대로 들어감). 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# DATABASE_URL 호스트는 Django를 어디서 실행하느냐에 따라 다릅니다.
#   - PC 가상환경에서 실행 (현재): 127.0.0.1
#     (localhost는 Windows에서 IPv6 ::1로 먼저 연결을 시도해 멈출 수 있어 쓰지 않음)
#   - Docker web 컨테이너에서 실행 (#5부터): db  (예: postgres://lemit:비밀번호@db:5432/lemit)
DATABASE_URL=postgres://lemit:change-me@127.0.0.1:5432/lemit

# 비밀번호 재설정 메일 (UC-15, docs/DEPLOY.md)
# 비워 두면(개발) 메일 내용을 콘솔(runserver·컨테이너 로그)에 출력합니다.
# 운영: Gmail 주소와 앱 비밀번호(Google 계정 2단계 인증 후 발급한 16자리, 공백 없이)를 넣으면 Gmail SMTP로 보냅니다.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 보내는 사람 표시 (선택, 비우면 EMAIL_HOST_USER). 예: LEMIT <you@gmail.com>
DEFAULT_FROM_EMAIL=

# 운영 서버 전용 (#7, docs/DEPLOY.md §2). 개발 PC에서는 비워 두거나 기본값을 쓴다.
# 배포 전 scripts/preflight.sh가 아래 값들의 조합을 검사한다 (도메인이면 BEHIND_PROXY·SECURE_HTTPS=True, ALLOWED_HOSTS 첫 값=도메인 등)
# TLS 리버스 프록시(Caddy) 주소: 도메인이면 자동 HTTPS, 도메인이 없으면 :80 (IP로 HTTP 시연)
SITE_ADDRESS=:80
# 프록시 뒤에서 X-Forwarded-Proto를 믿을지 (proxy 프로필을 쓸 때만 True)
DJANGO_BEHIND_PROXY=False
# 도메인 + HTTPS일 때만 True: HTTPS 강제, 보안 쿠키 (헬스체크 /healthz/는 예외)
DJANGO_SECURE_HTTPS=False
# HSTS(초). 되돌리기 어려우므로 0에서 시작
DJANGO_HSTS_SECONDS=0
# gunicorn worker 수 (메모리 1GB면 1, 2GB면 2)
GUNICORN_WORKERS=2
