# 개발용 예시입니다. 이 파일을 .env로 복사해 값을 채웁니다 (복사 명령은 README "환경변수 설정").
# .env는 커밋하지 않습니다.
# 운영 서버(#7)에서는 새 비밀키, DJANGO_DEBUG=False, 실제 도메인의 ALLOWED_HOSTS·CSRF_TRUSTED_ORIGINS를 씁니다.

# 새 키 만들기: python -c "import secrets; print(secrets.token_urlsafe(50))"
# ($ 문자는 Docker Compose가 변수로 해석하므로 넣지 않습니다)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL 18 (개발용 compose.yaml의 db 서비스 기준)
POSTGRES_DB=lemit
POSTGRES_USER=lemit
# 영문·숫자·-_ 만 (URL에 그대로 들어감). 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# DATABASE_URL 호스트는 Django를 어디서 실행하느냐에 따라 다릅니다.
#   - PC 가상환경에서 실행 (현재): 127.0.0.1
#     (localhost는 Windows에서 IPv6 ::1로 먼저 연결을 시도해 멈출 수 있어 쓰지 않음)
#   - Docker web 컨테이너에서 실행 (#5부터): db  (예: postgres://lemit:비밀번호@db:5432/lemit)
DATABASE_URL=postgres://lemit:change-me@127.0.0.1:5432/lemit

# 비밀번호 재설정 메일 (배포 시, UC-15)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
