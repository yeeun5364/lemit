# 이 파일을 .env로 복사해 값을 채웁니다:  cp .env.example .env
# .env는 커밋하지 않습니다.

# 새 키 만들기: python -c "import secrets; print(secrets.token_urlsafe(50))"
# ($ 문자는 Docker Compose가 변수로 해석하므로 넣지 않습니다)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL 18 (개발용 compose.yaml의 db 서비스 기준)
POSTGRES_DB=lemit
POSTGRES_USER=lemit
POSTGRES_PASSWORD=change-me
# localhost 대신 127.0.0.1: Windows에서 localhost가 IPv6(::1)로 먼저 연결을 시도해 멈추는 문제 방지
DATABASE_URL=postgres://lemit:change-me@127.0.0.1:5432/lemit

# 비밀번호 재설정 메일 (배포 시, UC-15)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
